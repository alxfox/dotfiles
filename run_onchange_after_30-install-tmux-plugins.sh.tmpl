#!/bin/sh
# tmux config: {{ include "dot_tmux.conf" | sha256sum }}
# tmux executable: {{ lookPath "tmux" }}
set -eu

if ! command -v tmux >/dev/null 2>&1; then
  exit 0
fi

tpm_installer="$HOME/.tmux/plugins/tpm/bin/install_plugins"
if [ ! -x "$tpm_installer" ]; then
  echo "Cannot install tmux plugins: TPM is missing." >&2
  exit 1
fi

"$tpm_installer"
