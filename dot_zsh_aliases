# lsd
alias l='lsd'
alias ll='lsd -l'
alias la='lsd -la'
alias lt='lsd --tree'
alias l1='lsd -1'

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'

# Common commands
alias c='clear'
alias h='history'
alias reload='source ~/.zshrc'
alias zshrc='$EDITOR ~/.zshrc'

# Safer file operations
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'

# Disk / system
alias df='df -h'
alias du='du -sh | sort -h'
alias free='free -h'

# Git
alias g='git'
alias gs='git status'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit'
alias gcm='git commit -m'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'
alias glog='git log --oneline --graph --decorate --all'

# Docker
alias d='docker'
alias dps='docker ps'
alias dpsa='docker ps -a'
alias di='docker images'
alias dex='docker exec -it'
alias dc='docker compose'
alias dcu='docker compose up'
alias dcud='docker compose up -d'
alias dcd='docker compose down'

# Networking
alias ports='ss -tulpn'
alias ipinfo='ip addr'
alias myip='curl -s https://ifconfig.me'

# Processes
alias psg='ps aux | grep'
alias mem='ps aux --sort=-%mem | head'
alias cpu='ps aux --sort=-%cpu | head'

# Disposable Debian container
alias debian='docker run --rm -it debian:latest bash'
