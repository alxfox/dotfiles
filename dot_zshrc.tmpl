{{ if .useOhMyZsh -}}
# Enable Powerlevel10k's instant prompt when available.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi
{{- end }}

HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt append_history autocd hist_ignore_dups hist_reduce_blanks notify
unsetopt beep nomatch
bindkey -e

{{ if .useOhMyZsh -}}
export ZSH="$HOME/.oh-my-zsh"
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  DISABLE_AUTO_UPDATE="true"
  if [[ -r "$ZSH/custom/themes/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
    ZSH_THEME="powerlevel10k/powerlevel10k"
  else
    ZSH_THEME="robbyrussell"
  fi
  plugins=(git)
  source "$ZSH/oh-my-zsh.sh"
else
  autoload -Uz compinit
  compinit
  autoload -Uz colors && colors
  PROMPT='%F{cyan}%n@%m%f:%F{blue}%~%f %# '
fi
{{- else }}
autoload -Uz compinit
compinit
autoload -Uz colors && colors
PROMPT='%F{cyan}%n@%m%f:%F{blue}%~%f %# '
{{- end }}

source ~/.zsh_aliases

# nvm's alias parser requires standard glob patterns.
unsetopt extendedglob
if [[ -r "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]]; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  source "$NVM_DIR/nvm.sh"
elif [[ -r /usr/share/nvm/init-nvm.sh ]]; then
  source /usr/share/nvm/init-nvm.sh
fi

{{ if .useOhMyZsh -}}
[[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
{{- end }}
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
