# Shared aliases for bash and zsh. Sourced by ~/.config/shell/{bash,zsh}rc.

# Directory listing
if command -v lsd >/dev/null 2>&1; then
  alias l='lsd'
  alias ll='lsd -l'
  alias la='lsd -la'
  alias lt='lsd --tree'
  alias l1='lsd -1'
else
  alias l='ls'
  alias ll='ls -lh'
  alias la='ls -lah'
  alias lt='ls -R'
  alias l1='ls -1'
fi

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'

# Common commands
alias c='clear'
alias h='history'

# Optional install commands printed after the first chezmoi apply
if command -v chezmoi >/dev/null 2>&1; then
  alias install-hints='sh "$(chezmoi source-path)/run_once_after_99-print-install-commands.sh"'
fi

# Safer file operations
alias cp='cp -i'
alias mv='mv -i'

# Git
if command -v git >/dev/null 2>&1; then
  alias g='git'
  alias gs='git status'
  alias ga='git add'
  alias gaa='git add --all'
  alias gc='git commit'
  alias gcm='git commit -m'
  alias gp='git push'
  alias gl='git pull'
  alias gd='git diff'
  alias gco='git checkout'
  alias gb='git branch'
  alias glog='git log --oneline --graph --decorate --all'
fi

# Docker
if command -v docker >/dev/null 2>&1; then
  alias d='docker'
  alias dps='docker ps'
  alias dpsa='docker ps -a'
  alias di='docker images'
  alias dex='docker exec -it'
  alias dc='docker compose'
  alias dcu='docker compose up'
  alias dcud='docker compose up -d'
  alias dcd='docker compose down'
  alias debian='docker run --rm -it debian:latest bash'
fi

# Networking
if command -v ss >/dev/null 2>&1; then
  alias ports='ss -tulpn'
elif command -v lsof >/dev/null 2>&1; then
  alias ports='lsof -i -P -n'
fi

if command -v ip >/dev/null 2>&1; then
  alias ipinfo='ip addr'
elif command -v ifconfig >/dev/null 2>&1; then
  alias ipinfo='ifconfig'
fi

if command -v curl >/dev/null 2>&1; then
  alias myip='curl -fsS https://ifconfig.me'
fi

# Processes
if command -v ps >/dev/null 2>&1 && command -v grep >/dev/null 2>&1; then
  alias psg='ps aux | grep'
fi

if [ "$(uname -s)" = Linux ]; then
  alias mem='ps aux --sort=-%mem | head'
  alias cpu='ps aux --sort=-%cpu | head'
fi
