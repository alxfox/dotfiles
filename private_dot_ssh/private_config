Include ~/.ssh/config.local

Host foxpi
  HostName 192.168.2.9
  User fox

Host serverfox
  User fox
  ConnectTimeout 5

Host alienware3
  HostName 10.162.40.97
  User ubuntu

# Prefer the LAN address when connected to the home subnet.
Match originalhost serverfox exec "ip -4 route get 192.168.2.42 2>/dev/null | grep -q 'src 192\\.168\\.2\\.'"
  HostName 192.168.2.42

# HostName uses the first value found, so this is only the fallback.
Match originalhost serverfox
  HostName serverfox.foxhound-ling.ts.net
